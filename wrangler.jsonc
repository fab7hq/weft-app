// One Worker on weft.getfab7.com: the web app's static files, and a small API
// for sign-in, the person's Macs and their addresses (account.md §2). Only
// /api/*, /auth/* and /words.json run the Worker; every other path is a static file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weft-app",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/words.json"]
  },
  // A Custom Domain: the Worker is the origin, DNS and certificate are Cloudflare's.
  "routes": [{ "pattern": "weft.getfab7.com", "custom_domain": true }],
  "vars": {
    // The Fab7 Weft GitHub App (account.md §3); its client secret is a secret.
    "GITHUB_CLIENT_ID": "Iv23liun7wYzjax5d6p3"
  },
  // Workers Logs: each request, and a line for every machine or account removed.
  "observability": { "enabled": true },
  // Expired sessions are deleted once a day.
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weft",
      "database_id": "11b1e16b-dab0-4c58-a3a4-30dca34a7e09",
      "migrations_dir": "migrations"
    }
  ]
}
