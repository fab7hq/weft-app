// One Worker on weft.getfab7.com: the web app's static files, and a small API
// for sign-in, the person's Macs and their addresses (account.md §2). Only
// /api/* and /auth/* run the Worker; every other path is a static file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weft-app",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    // The Fab7 Weft GitHub App (account.md §3); its client secret is a secret.
    "GITHUB_CLIENT_ID": "Iv23liun7wYzjax5d6p3"
  },
  // Expired sessions are deleted once a day.
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weft",
      // Made by the owner with `wrangler d1 create weft` at deploy (step 31).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
